new file mode 100644
index 0000000..f80df05
--- /dev/null
+++ b/Sources/Heeler/Transport/AttachedTransport.swift
@@ -0,0 +1,157 @@
+import AttachedMobile
+import Darwin
+import Foundation
+import HeelerSSH
+
+/// One Iroh endpoint per account across all Hosts and terminal connections.
+/// Account secrets live only in the device Keychain and Rust's zeroizing memory.
+actor AttachedAccounts {
+    static let shared = AttachedAccounts()
+    static let keychain = KeychainSecretStore(service: "dev.bybee.heeler.attached")
+    private var clients: [String: AttachedClient] = [:]
+
+    func client(for accountID: String) throws -> AttachedClient {
+        if let existing = clients[accountID] { return existing }
+        guard let data = try Self.keychain.read(account: accountID),
+            let bundle = String(data: data, encoding: .utf8)
+        else { throw AttachedConnectionError.missingAccount }
+        let client = try AttachedClient(downloadBundle: bundle)
+        guard client.accountId() == accountID else { throw AttachedConnectionError.invalidAccount }
+        clients[accountID] = client
+        return client
+    }
+
+    func save(bundle: String, accountID: String) throws {
+        let validated = try AttachedClient(downloadBundle: bundle)
+        guard validated.accountId() == accountID else {
+            throw AttachedConnectionError.invalidAccount
+        }
+        // Persist before retiring existing connections, so a Keychain failure
+        // leaves the working account untouched.
+        let data = Data(bundle.utf8)
+        if try Self.keychain.read(account: accountID) == data { return }
+        try Self.keychain.write(data, account: accountID)
+        clients.removeValue(forKey: accountID)?.close()
+        clients[accountID] = validated
+    }
+
+    func evict(accountID: String) {
+        clients.removeValue(forKey: accountID)?.close()
+    }
+}
+
+enum AttachedConnectionError: LocalizedError {
+    case missingAccount
+    case invalidAccount
+    case unsupportedAuthentication
+    case hostIdentityMismatch
+
+    var errorDescription: String? {
+        switch self {
+        case .missingAccount: "Import this Host's Attached download bundle again."
+        case .invalidAccount: "Use a download bundle exported by Attached."
+        case .unsupportedAuthentication: "Attached Hosts use this device's Ed25519 Device Key."
+        case .hostIdentityMismatch:
+            "The SSH key does not match the authenticated Attached publisher."
+        }
+    }
+}
+
+/// Owns only the Rust side after takeDescriptor. SessionDriver owns the
+/// transferred socket and closes it on every handshake/teardown path.
+final class AttachedByteTransport: SSHByteTransport, Sendable {
+    private let tunnel: AttachedTunnel
+    // Retain the shared endpoint until all SSH traffic is finished.
+    private let client: AttachedClient
+
+    init(tunnel: AttachedTunnel, client: AttachedClient) {
+        self.tunnel = tunnel
+        self.client = client
+    }
+
+    func takeDescriptor() throws -> Int32 {
+        let descriptor = try tunnel.takeSocket()
+        var enabled: Int32 = 1
+        guard
+            setsockopt(
+                descriptor, SOL_SOCKET, SO_NOSIGPIPE, &enabled,
+                socklen_t(MemoryLayout<Int32>.size)) == 0
+        else {
+            Darwin.close(descriptor)
+            throw SSHError.connectionFailed
+        }
+        return descriptor
+    }
+
+    func close(timeout: Duration) async throws { tunnel.close() }
+    func abort() { tunnel.close() }
+    deinit { tunnel.close() }
+}
+
+enum AttachedTransport {
+    static func connect(settings: SSHTransportSettings) async throws -> SSHConnection {
+        guard let accountID = settings.attachedAccountID,
+            case .ed25519(let privateKey) = settings.credentials,
+            settings.jump == nil
+        else { throw AttachedConnectionError.unsupportedAuthentication }
+        let client = try await AttachedAccounts.shared.client(for: accountID)
+        let key = DeviceKey(privateKey: privateKey)
+        let cancellation = AttachedCancellation()
+        let tunnel = try await withTaskCancellationHandler {
+            // UniFFI's synchronous API runs on a worker, never on MainActor.
+            let tunnel: AttachedTunnel
+            do {
+                tunnel = try await Task.detached {
+                    try client.connect(
+                        endpointId: settings.host, publicKey: key.openSSHPublicKey,
+                        cancellation: cancellation)
+                }.value
+            } catch {
+                if Task.isCancelled { throw TransportError.cancelled }
+                throw TransportError.sshUnreachable(
+                    detail:
+                        "Attached could not reach this Host. Check the download bundle and run the updated attached serve on the Host."
+                )
+            }
+            if Task.isCancelled {
+                tunnel.close()
+                throw TransportError.cancelled
+            }
+            return tunnel
+        } onCancel: {
+            cancellation.cancel()
+        }
+        let transport = AttachedByteTransport(tunnel: tunnel, client: client)
+        let connection: SSHConnection
+        do {
+            connection = try await SSHConnection.connect(
+                over: transport,
+                endpoint: SSHEndpoint(host: settings.host), timeout: settings.requestTimeout)
+        } catch {
+            transport.abort()
+            throw error
+        }
+        do {
+            try validateHostKey(connection.hostKey, admissionKey: tunnel.hostKey())
+            try await HeelerSSHHostKeyVerifier(
+                host: settings.host, port: settings.port, policy: settings.hostKeyPolicy
+            )
+            .verify(connection.hostKey)
+            try await connection.authenticate(
+                username: tunnel.username(), publicKey: key.publicKeyBlob,
+                signer: { data in try privateKey.signature(for: data) },
+                timeout: settings.requestTimeout)
+            return connection
+        } catch {
+            try? await connection.close(timeout: .seconds(2))
+            throw error
+        }
+    }
+
+    static func validateHostKey(_ key: SSHHostKey, admissionKey: String) throws {
+        let parts = admissionKey.split(separator: " ", omittingEmptySubsequences: true)
+        guard parts.count == 2, parts[0] == "ssh-ed25519", key.algorithm == "ssh-ed25519",
+            let data = Data(base64Encoded: String(parts[1])), data == key.key
+        else { throw AttachedConnectionError.hostIdentityMismatch }
+    }
+}
