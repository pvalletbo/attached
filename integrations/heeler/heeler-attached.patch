diff --git a/Packages/HeelerSSH/Tests/HeelerSSHTests/EmbeddedTransportTests.swift b/Packages/HeelerSSH/Tests/HeelerSSHTests/EmbeddedTransportTests.swift
new file mode 100644
index 0000000..dbdf95d
--- /dev/null
+++ b/Packages/HeelerSSH/Tests/HeelerSSHTests/EmbeddedTransportTests.swift
@@ -0,0 +1,65 @@
+import Darwin
+import Foundation
+import Synchronization
+import Testing
+
+@testable import HeelerSSH
+
+private final class FailedEmbeddedTransport: SSHByteTransport, Sendable {
+    private struct State {
+        var descriptor: Int32
+        var aborted = false
+        var closed = false
+    }
+    private let state: Mutex<State>
+    let transferredDescriptor: Int32
+
+    init() throws {
+        var pair: [Int32] = [-1, -1]
+        guard socketpair(AF_UNIX, SOCK_STREAM, 0, &pair) == 0 else {
+            throw SSHError.connectionFailed
+        }
+        var enabled: Int32 = 1
+        guard fcntl(pair[0], F_SETFL, O_NONBLOCK) == 0,
+            setsockopt(
+                pair[0], SOL_SOCKET, SO_NOSIGPIPE, &enabled,
+                socklen_t(MemoryLayout<Int32>.size)) == 0
+        else {
+            Darwin.close(pair[0])
+            Darwin.close(pair[1])
+            throw SSHError.connectionFailed
+        }
+        Darwin.close(pair[1])
+        transferredDescriptor = pair[0]
+        state = Mutex(State(descriptor: pair[0]))
+    }
+
+    func takeDescriptor() throws -> Int32 {
+        try state.withLock {
+            guard $0.descriptor >= 0 else { throw SSHError.connectionInvalidated }
+            let descriptor = $0.descriptor
+            $0.descriptor = -1
+            return descriptor
+        }
+    }
+    func abort() { state.withLock { $0.aborted = true } }
+    func close(timeout: Duration) async throws { state.withLock { $0.closed = true } }
+    var wasReleased: Bool { state.withLock { $0.aborted && $0.closed } }
+    deinit { state.withLock { if $0.descriptor >= 0 { Darwin.close($0.descriptor) } } }
+}
+
+@Suite("Embedded byte transport")
+struct EmbeddedTransportTests {
+    @Test func failedHandshakeClosesTransferredSocketAndAbortsTransport() async throws {
+        let transport = try FailedEmbeddedTransport()
+        do {
+            _ = try await SSHConnection.connect(
+                over: transport, endpoint: SSHEndpoint(host: "embedded"), timeout: .seconds(2))
+            Issue.record("Handshake on a closed transport unexpectedly succeeded")
+        } catch {
+            #expect(transport.wasReleased)
+            #expect(fcntl(transport.transferredDescriptor, F_GETFD) == -1)
+            #expect(errno == EBADF)
+        }
+    }
+}
