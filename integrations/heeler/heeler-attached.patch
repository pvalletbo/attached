@@ -0,0 +1,68 @@
+import CryptoKit
+import Foundation
+import HeelerSSH
+import Testing
+
+@testable import Heeler
+
+@Suite("Attached transport")
+struct AttachedTransportTests {
+    @Test func admissionKeyMustMatchTheSSHHandshakeBeforeAuthentication() throws {
+        let device = DeviceKey(privateKey: Curve25519.Signing.PrivateKey())
+        let key = SSHHostKey(algorithm: "ssh-ed25519", key: device.publicKeyBlob)
+        try AttachedTransport.validateHostKey(key, admissionKey: device.openSSHPublicKey)
+        let other = DeviceKey(privateKey: Curve25519.Signing.PrivateKey())
+        #expect(throws: (any Error).self) {
+            try AttachedTransport.validateHostKey(key, admissionKey: other.openSSHPublicKey)
+        }
+        for invalid in ["", "ssh-ed25519 !", device.openSSHPublicKey + "\nother-host key"] {
+            #expect(throws: (any Error).self) {
+                try AttachedTransport.validateHostKey(key, admissionKey: invalid)
+            }
+        }
+    }
+
+    @Test func oldHostsRemainSSHAndAttachedEditsRetainTheAccountReference() throws {
+        let legacy = Host(address: "host.example", username: "user")
+        var json = try #require(
+            JSONSerialization.jsonObject(with: JSONEncoder().encode(legacy)) as? [String: Any])
+        json.removeValue(forKey: "attachedAccountID")
+        let restored = try JSONDecoder().decode(
+            Host.self, from: JSONSerialization.data(withJSONObject: json))
+        #expect(restored.attachedAccountID == nil)
+        let attached = Host(
+            name: "Office", address: String(repeating: "a", count: 64),
+            username: "attached", attachedAccountID: UUID().uuidString)
+        var draft = HostDraft(host: attached)
+        draft.name = "My office"
+        let edited = try #require(draft.makeHost(id: attached.id))
+        #expect(edited.attachedAccountID == attached.attachedAccountID)
+        #expect(edited.address == attached.address)
+        #expect(edited.authMethod == .deviceKey)
+        #expect(try JSONDecoder().decode(Host.self, from: JSONEncoder().encode(edited)) == edited)
+    }
+
+    @MainActor @Test func removingLastHostRemovesOnlyItsAccountSecret() throws {
+        let defaultsName = "attached-tests-\(UUID().uuidString)"
+        let defaults = try #require(UserDefaults(suiteName: defaultsName))
+        defer { defaults.removePersistentDomain(forName: defaultsName) }
+        let secrets = VolatileSecretStore()
+        try secrets.write(Data("download-secret".utf8), account: "shared")
+        try secrets.write(Data("other-secret".utf8), account: "other")
+        let store = HostStore(
+            defaults: defaults, secrets: VolatileSecretStore(), attachedSecrets: secrets)
+        let one = Host(address: "one", username: "attached", attachedAccountID: "shared")
+        let two = Host(address: "two", username: "attached", attachedAccountID: "shared")
+        try store.add(one)
+        try store.add(two)
+        #expect(
+            !(defaults.data(forKey: "hosts").map { String(decoding: $0, as: UTF8.self) } ?? "")
+                .contains(
+                    "download-secret"))
+        try store.remove(one.id)
+        #expect(try secrets.read(account: "shared") != nil)
+        try store.remove(two.id)
+        #expect(try secrets.read(account: "shared") == nil)
+        #expect(try secrets.read(account: "other") != nil)
+    }
+}
diff --git a/docs/guides/attached.md b/docs/guides/attached.md
new file mode 100644
index 0000000..57f1f6c
--- /dev/null
+++ b/docs/guides/attached.md
@@ -0,0 +1,79 @@
+# Testing Heeler with Attached
+
+This integration was developed with AI assistance. It is intended for source
+builds and device testing; the complete iPhone/iPad path still needs validation.
+
+## Build on a Mac
+
+Install full Xcode 26 or later, XcodeGen 2.46 or later, and Rust through rustup.
+Select Xcode with `xcode-select` and complete its first-launch setup. Then, from
+this Heeler checkout:
+
+```sh
+rustup toolchain install 1.97.1 --profile minimal
+make attached-client
+make generate
+make build-sim
+```
+
+`make attached-client` fetches exactly `scripts/attached-revision` from
+`pvalletbo/attached` and builds a local Swift package. It compiles the host Mac,
+arm64 iOS device, and arm64/x86_64 simulator libraries. The first build takes
+longer; subsequent builds reuse Cargo artifacts and the package revision stamp.
+Set `FORCE_ATTACHED_BUILD=1` to rebuild it. No native binary from this integration
+is downloaded from an unpinned release.
+
+Open `Heeler.xcodeproj`, configure your own signing team and unique bundle IDs
+for the app and its extensions, and select your iPhone or iPad to build and run.
+The upstream app has push and App Group entitlements: device provisioning must
+support those capabilities. The simulator does not need your signing team.
+Do not commit signing credentials. `make generate` regenerates project settings,
+so keep permanent signing changes in your local `project.yml` when needed.
+
+## Prepare each Host
+
+Build/install Attached from the same pinned commit and restart `attached serve`
+under the OS account that owns the Herdr sessions. The normal publish bundle
+setup remains unchanged. The publisher must include the new PTY and Unix-socket
+forwarding support from [Attached PR 107](https://github.com/pvalletbo/attached/pull/107).
+Use a current Herdr version supported by Heeler (the schema baseline is 0.9.0).
+
+On the account-owning computer, export a download bundle:
+
+```sh
+attached account export --type download
+```
+
+In Heeler, choose **Hosts → Add Host → Attached Host**, paste that bundle, and
+choose an active Host. Repeat for other Hosts. Confirm its SSH host fingerprint
+on first connection. Choose the Herdr session in the existing Host setup screen.
+The bundle is a credential: Heeler stores it in the device Keychain, not in its
+Host catalog. Removing the last Host for an account removes that account secret.
+The SSH Device Key stays on the device and does not need an `authorized_keys`
+entry: Attached admits its public half inside each authorized Iroh connection.
+
+## Scope and checks
+
+The existing Console, Agent controls, Agent Attach and ordinary Shell Terminal
+use SSH over Iroh. Hosts are selected by stable endpoint ID. No VPN extension,
+public SSH listener, copied TUI implementation, or local TCP proxy is needed.
+
+File/image uploads are hidden for Attached Hosts. SFTP-dependent operations
+(including push registration, remote directory browsing and session-file usage
+figures) are unavailable. Standard SSH Hosts keep their existing behavior.
+Foreground reconnect reuses Heeler's existing lifecycle; this does not promise
+background terminal connectivity while iOS suspends the app. Attached still has
+one shared consumer identity per account, so concurrent desktop/mobile use needs
+testing; this change does not introduce per-device enrollment or revocation.
+
+Focused tests on the Mac:
+
+```sh
+make test-app TEST_FLAGS='-only-testing:HeelerTests/AttachedTransportTests -only-testing:HeelerTests/HostDraftTests -only-testing:HeelerTests/HostStoreTests'
+scripts/run-heelerssh-package-tests.sh
+```
+
+On a device, verify Agent Attach, shell typing and resizing, leaving and reopening
+a terminal, switching Hosts/sessions, Wi-Fi-to-cellular reconnect, and a publisher
+restart. Leaving a terminal should detach without logging out its persistent
+shell. Compare a known-good standard SSH Host if diagnosing a Herdr/API issue.
