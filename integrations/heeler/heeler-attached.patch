diff --git a/Sources/Heeler/Hosts/AttachedHostImportView.swift b/Sources/Heeler/Hosts/AttachedHostImportView.swift
new file mode 100644
index 0000000..5ad48d4
--- /dev/null
+++ b/Sources/Heeler/Hosts/AttachedHostImportView.swift
@@ -0,0 +1,143 @@
+import AttachedMobile
+import SwiftUI
+
+/// Discover first, then explicitly choose a Host. No account secret is stored
+/// in the Host catalog, copied to the pasteboard, or sent to an SSH command.
+struct AttachedHostImportView: View {
+    let store: HostStore
+    var onSaved: (Host) -> Void
+    @Environment(\.dismiss) private var dismiss
+    @State private var bundle = ""
+    @State private var accountID: String?
+    @State private var hosts: [AttachedHost] = []
+    @State private var isWorking = false
+    @State private var failure: String?
+    @State private var operation: Task<Void, Never>?
+
+    var body: some View {
+        NavigationStack {
+            Form {
+                if accountID == nil {
+                    Section {
+                        SecureField("Attached download bundle", text: $bundle)
+                            .textInputAutocapitalization(.never)
+                            .autocorrectionDisabled()
+                        Button("Find Hosts") { discover() }
+                            .disabled(
+                                bundle.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
+                                    || isWorking)
+                    } footer: {
+                        Text(
+                            "On your computer, run attached account export --type download and paste the bundle here. It is stored in this device's Keychain when you add a Host."
+                        )
+                    }
+                } else {
+                    Section("Available Hosts") {
+                        ForEach(hosts, id: \.endpointId) { host in
+                            Button {
+                                add(host)
+                            } label: {
+                                VStack(alignment: .leading) {
+                                    Text(host.label)
+                                    Text(host.endpointId).font(.caption.monospaced()).lineLimit(1)
+                                }
+                            }.disabled(isWorking)
+                        }
+                        if hosts.isEmpty {
+                            Text(
+                                "No active Hosts found. Start attached serve on a Host, then try again."
+                            )
+                        }
+                        Button("Use another bundle") {
+                            accountID = nil
+                            hosts = []
+                        }
+                        .disabled(isWorking)
+                    }
+                }
+                if isWorking { ProgressView("Connecting to Attached…") }
+                if let failure { Section { Text(failure).foregroundStyle(.red) } }
+                Section {
+                    Text(
+                        "Run the updated Attached server from this integration on each Host. Terminal access and Herdr controls are supported. File transfers and push registration are not available through Attached yet."
+                    )
+                }
+            }
+            .navigationTitle("Add Attached Host")
+            .toolbar {
+                ToolbarItem(placement: .cancellationAction) {
+                    Button("Cancel") {
+                        operation?.cancel()
+                        dismiss()
+                    }
+                }
+            }
+            .onDisappear {
+                operation?.cancel()
+                bundle = ""
+            }
+        }
+    }
+
+    private func discover() {
+        failure = nil
+        isWorking = true
+        let encoded = bundle.trimmingCharacters(in: .whitespacesAndNewlines)
+        operation = Task {
+            defer { isWorking = false }
+            let cancellation = AttachedCancellation()
+            do {
+                let result = try await withTaskCancellationHandler {
+                    try await Task.detached {
+                        let client = try AttachedClient(downloadBundle: encoded)
+                        defer { client.close() }
+                        return (client.accountId(), try client.hosts(cancellation: cancellation))
+                    }.value
+                } onCancel: {
+                    cancellation.cancel()
+                }
+                try Task.checkCancellation()
+                accountID = result.0
+                hosts = result.1
+                bundle = encoded
+            } catch {
+                if !Task.isCancelled {
+                    failure =
+                        "Could not discover Hosts. Check the download bundle, network connection, and Attached service."
+                }
+            }
+        }
+    }
+
+    private func add(_ discovered: AttachedHost) {
+        guard let accountID else { return }
+        isWorking = true
+        failure = nil
+        let encoded = bundle
+        operation = Task {
+            defer { isWorking = false }
+            do {
+                try await AttachedAccounts.shared.save(bundle: encoded, accountID: accountID)
+                try Task.checkCancellation()
+                if let existing = store.hosts.first(where: {
+                    $0.attachedAccountID == accountID && $0.address == discovered.endpointId
+                }) {
+                    onSaved(existing)
+                    dismiss()
+                    return
+                }
+                let host = Host(
+                    name: discovered.label, address: discovered.endpointId,
+                    username: "attached", attachedAccountID: accountID)
+                try store.add(host)
+                bundle = ""
+                onSaved(host)
+                dismiss()
+            } catch {
+                if !Task.isCancelled {
+                    failure = "Could not save the Attached Host to this device."
+                }
+            }
+        }
+    }
+}
