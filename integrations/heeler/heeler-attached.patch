+#!/usr/bin/env bash
+set -euo pipefail
+ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+REVISION="$(tr -d '\n' < "$ROOT/scripts/attached-revision")"
+[[ "$REVISION" =~ ^[0-9a-f]{40}$ ]] || { echo 'Invalid Attached revision pin.' >&2; exit 1; }
+OUTPUT="$ROOT/Packages/AttachedMobile"
+STAMP="$OUTPUT/.attached-revision"
+if [[ "${FORCE_ATTACHED_BUILD:-0}" != 1 && -f "$STAMP" && "$(cat "$STAMP")" == "$REVISION" \
+      && -f "$OUTPUT/Artifacts/AttachedMobileFFI.xcframework/Info.plist" \
+      && -f "$OUTPUT/Sources/AttachedMobile/AttachedMobile.swift" ]]; then
+  exit 0
+fi
+[[ "$(uname -s)" == Darwin ]] || { echo 'Building AttachedMobile requires macOS with Xcode.' >&2; exit 1; }
+CACHE="$ROOT/.ci/attached-source"
+if [[ ! -d "$CACHE/.git" ]]; then
+  mkdir -p "$CACHE"
+  git -C "$CACHE" init
+  git -C "$CACHE" remote add origin https://github.com/pvalletbo/attached.git
+fi
+[[ -z "$(git -C "$CACHE" status --porcelain)" ]] || { echo 'Attached build checkout has local changes; preserve them before rebuilding.' >&2; exit 1; }
+git -C "$CACHE" fetch --depth 1 origin "$REVISION"
+git -C "$CACHE" checkout --detach "$REVISION"
+"$CACHE/scripts/build-apple-client.sh" "$OUTPUT"
+printf '%s\n' "$REVISION" > "$STAMP"
