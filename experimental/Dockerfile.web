FROM rust:1.97.1-bookworm AS wasm-builder

RUN apt-get update \
    && apt-get install --yes --no-install-recommends clang \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add wasm32-unknown-unknown \
    && cargo install wasm-bindgen-cli --version 0.2.126 --locked

WORKDIR /app
COPY . .

ENV CC_wasm32_unknown_unknown=clang
RUN cargo build --locked --release \
      -p herdr-tui-protocol \
      -p attached-browser-sync \
      -p attached-browser-iroh \
      --target wasm32-unknown-unknown \
    && mkdir -p \
      experimental/web-client/src/protocol-bindings \
      experimental/web-client/src/sync-bindings \
      experimental/web-client/src/iroh-bindings \
    && wasm-bindgen \
      --target web \
      --out-dir experimental/web-client/src/protocol-bindings \
      --out-name herdr_tui_protocol \
      target/wasm32-unknown-unknown/release/herdr_tui_protocol.wasm \
    && wasm-bindgen \
      --target web \
      --out-dir experimental/web-client/src/sync-bindings \
      --out-name attached_browser_sync \
      target/wasm32-unknown-unknown/release/attached_browser_sync.wasm \
    && wasm-bindgen \
      --target web \
      --out-dir experimental/web-client/src/iroh-bindings \
      --out-name attached_browser_iroh \
      target/wasm32-unknown-unknown/release/attached_browser_iroh.wasm

FROM node:24-bookworm-slim AS web-builder

RUN npm install --global pnpm@11.0.8

WORKDIR /app/experimental/web-client
COPY experimental/web-client/package.json experimental/web-client/pnpm-lock.yaml experimental/web-client/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY experimental/web-client/ ./
COPY --from=wasm-builder /app/experimental/web-client/src/protocol-bindings ./src/protocol-bindings
COPY --from=wasm-builder /app/experimental/web-client/src/sync-bindings ./src/sync-bindings
COPY --from=wasm-builder /app/experimental/web-client/src/iroh-bindings ./src/iroh-bindings

RUN pnpm run build:app \
    && node copy-wasm-bindings.mjs

FROM nginxinc/nginx-unprivileged:1.27.5-alpine AS runtime

COPY experimental/web-client/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=web-builder /app/experimental/web-client/dist /usr/share/nginx/html
COPY LICENSE /usr/share/nginx/html/LICENSE

EXPOSE 8080
