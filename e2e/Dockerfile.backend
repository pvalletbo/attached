# Same Rust harness build as e2e/Dockerfile, including offline regression tests.
FROM rust:1.97.1-bookworm AS harness-build
WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY .github/workflows ./.github/workflows
COPY dist-workspace.toml ./
ENV CARGO_PROFILE_DEV_DEBUG=0 CARGO_INCREMENTAL=0
RUN cargo build --locked --jobs 1 --package attached-e2e
RUN cargo test --locked --offline --jobs 1 --package attached-e2e

# Keep tool installation independent of harness/source changes for Docker caching.
FROM rust:1.97.1-bookworm AS build
RUN rustup target add wasm32-unknown-unknown \
    && cargo install worker-build --version 0.8.5 --locked --jobs 1
WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY --from=harness-build /build/target/debug/attached-e2e /usr/local/bin/attached-e2e
WORKDIR /build/crates/session-sync-worker
ENV CARGO_BUILD_JOBS=1
RUN worker-build --release --locked
# Keep real bindings/migrations; remove startup rebuilds and deployment metadata.
RUN attached-e2e __backend-config wrangler.toml > /build/wrangler.local.json

FROM node:22-bookworm-slim AS runtime
# Request.cf metadata is not used by the API; do not fetch it from Cloudflare.
ENV CI=true WRANGLER_SEND_METRICS=false CLOUDFLARE_CF_FETCH_ENABLED=false HOME=/home/node
WORKDIR /app/worker
COPY crates/session-sync-worker/package.json crates/session-sync-worker/pnpm-lock.yaml crates/session-sync-worker/pnpm-workspace.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY --from=build /build/wrangler.local.json ./wrangler.local.json
COPY --from=build /build/crates/session-sync-worker/build ./build
USER node
# Writable paths and the local Durable Object database are tmpfs mounts.
CMD ["timeout", "600", "./node_modules/.bin/wrangler", "dev", "--config", "wrangler.local.json", "--local", "--ip", "0.0.0.0", "--port", "8787", "--inspector-port", "0", "--persist-to", "/state", "--log-level", "warn"]
